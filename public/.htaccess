# ----------------------------------------------------------------------
# N.A Fresh Fruits & Coconuts - Public Directory Apache Configuration
# ----------------------------------------------------------------------

# Disable Directory Browsing
Options -Indexes -MultiViews

# Default Index
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block hidden files and dotfiles
    RewriteRule (^\.|/\.) - [F,L]

    # Send requests to existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other URLs to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
